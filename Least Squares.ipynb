    "x, residuals, rank, s = np.linalg.lstsq(A, b, rcond=None)\n",
    "\n",
    "print(f\"Least-squares solution (x_1, x_2): {x}\")\n",
    "print(f\"Sum of squared residuals: {residuals}\")"
   ]
